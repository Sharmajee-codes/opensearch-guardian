plugins {
    id 'java'
    id 'maven-publish'
    id 'signing'
}

group = 'org.opensearch.guardian'
version = '1.0.0'

java {
    sourceCompatibility = JavaVersion.VERSION_11
    targetCompatibility = JavaVersion.VERSION_11
}

repositories {
    mavenCentral()
    maven { url 'https://artifacts.opensearch.org/releases/' }
    maven { url 'https://artifacts.opensearch.org/snapshots/' }
}

dependencies {
    // OpenSearch core - these should contain the common classes we need
    implementation 'org.opensearch:opensearch:2.14.0'
    implementation 'org.opensearch:opensearch-core:2.14.0'

    // OpenSearch common - explicitly add if needed
    implementation 'org.opensearch:opensearch-common:2.14.0'

    // Plugin testing - commented out due to 403 on artifacts.opensearch.org
    // testImplementation 'org.opensearch:opensearch-test-framework:2.14.0'
    testImplementation 'org.junit.jupiter:junit-jupiter:5.10.0'
    testImplementation 'org.mockito:mockito-core:5.7.0'
    testImplementation 'org.assertj:assertj-core:3.24.2'

    // JSON processing
    implementation 'com.fasterxml.jackson.core:jackson-databind:2.15.2'

    // Logging
    implementation 'org.apache.logging.log4j:log4j-api:2.20.0'
    implementation 'org.apache.logging.log4j:log4j-core:2.20.0'

    // Security - using OpenSearch core security interfaces instead
    // implementation 'org.opensearch.plugin:opensearch-security:2.14.0'
}

// Manual plugin descriptor generation
task generatePluginDescriptor {
    doLast {
        def pluginDir = file("${projectDir}/src/main/resources")
        pluginDir.mkdirs()
        def pluginDescrContent = """\
# Guardian OpenSearch Plugin
# Generated by Gradle
classname=org.opensearch.guardian.GuardianPlugin
name=guardian
version=1.0.0
description=OpenSearch Guardian - Monitoring, Diagnosis, Optimization, and Provisioning
java.version=11
license=Apache-2.0
minversion=2.14.0
""".stripIndent()

        file("${pluginDir}/plugin-descriptor.properties").text = pluginDescrContent
    }
}

// Make the processResources task depend on generatePluginDescriptor
processResources.dependsOn generatePluginDescriptor

test {
    useJUnitPlatform()
    testLogging {
        events 'passed', 'skipped', 'failed', 'standardOut', 'standardError'
        exceptionFormat 'full'
    }
    maxParallelForks = Runtime.runtime.availableProcessors()
}

tasks.withType(Test) {
    systemProperty 'tests.security.manager', 'false'
    systemProperty 'tests.seed', 'random'
    systemProperty 'tests.timeout.multiplier', '2'
}

jar {
    manifest {
        attributes(
                'OpenSearch-Plugin-Class': 'org.opensearch.guardian.GuardianPlugin',
                'OpenSearch-Plugin-Name': 'guardian',
                'OpenSearch-Plugin-Version': version,
                'OpenSearch-Plugin-Description': 'OpenSearch Guardian - Monitoring, Diagnosis, Optimization, and Provisioning',
                'OpenSearch-Plugin-Java-Version': '11',
                'OpenSearch-Plugin-Has-Native-Controller': 'false',
                'OpenSearch-Plugin-License': 'Apache-2.0'
        )
    }
    from {
        configurations.runtimeClasspath.collect { it.isDirectory() ? it : zipTree(it) }
    }
    duplicatesStrategy = DuplicatesStrategy.EXCLUDE
}

// Sources and Javadoc jars
task sourcesJar(type: Jar) {
    from sourceSets.main.allSource
    archiveClassifier = 'sources'
}

task javadocJar(type: Jar) {
    from javadoc
    archiveClassifier = 'javadoc'
}

artifacts {
    archives sourcesJar
    archives javadocJar
}

// Maven publishing
publishing {
    publications {
        mavenJava(MavenPublication) {
            from components.java
            artifactId = 'guardian-plugin'
            version = project.version

            artifact sourcesJar
            artifact javadocJar

            pom {
                name = 'OpenSearch Guardian Plugin'
                description = 'OpenSearch Guardian - Monitoring, Diagnosis, Optimization, and Provisioning'
                url = 'https://github.com/opensearch-guardian/opensearch-guardian'
                licenses {
                    license {
                        name = 'The Apache License, Version 2.0'
                        url = 'http://www.apache.org/licenses/LICENSE-2.0.txt'
                    }
                }
                developers {
                    developer {
                        id = 'opensearch-guardian'
                        name = 'OpenSearch Guardian Team'
                        email = 'guardian@opensearch.org'
                    }
                }
                scm {
                    url = 'https://github.com/opensearch-guardian/opensearch-guardian'
                    connection = 'scm:git:git://github.com/opensearch-guardian/opensearch-guardian.git'
                    developerConnection = 'scm:git:git@github.com:opensearch-guardian/opensearch-guardian.git'
                }
            }
        }
    }

    repositories {
        maven {
            name = 'sonatype'
            // Only activate when the 'publish' property is set
            if (project.hasProperty('publish')) {
                def releasesRepoUrl = "https://oss.sonatype.org/service/local/staging/deploy/maven2/"
                def snapshotsRepoUrl = "https://oss.sonatype.org/content/repositories/snapshots"
                url = version.endsWith('SNAPSHOT') ? snapshotsRepoUrl : releasesRepoUrl
                credentials {
                    username = project.hasProperty('ossrhUsername') ? ossrhUsername : System.getenv('MAVEN_USERNAME')
                    password = project.hasProperty('ossrhPassword') ? ossrhPassword : System.getenv('MAVEN_PASSWORD')
                }
            }
        }
    }
}

// Signing configuration
signing {
    required { project.hasProperty('publish') }
    sign publishing.publications.mavenJava
}

// Only apply signing configuration when publish is explicitly requested
if (project.hasProperty('publish')) {
    // GPG configuration for signing
    if (project.hasProperty('signing.gnupg.keyId')) {
        signing {
            useInMemoryPgpKeys(
                    project.property('signing.gnupg.keyId'),
                    project.property('signing.gnupg.passphrase')
            )
        }
    }
}